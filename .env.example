# Planner model access: a key for at least one provider (`jive --demo` needs no keys).
# Internal endpoints and other providers go in ~/.config/jive/models.json.
OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# Jev decision service (required for graphs that use `jev` nodes).
JEV_API_TOKEN=

# Optional overrides. Defaults are shown; any provider:model reference works.
# JIVE_MODEL=google/gemini-3.8-flash
# JEV_MODEL=jev-1.13.0
# JEV_BASE_URL=https://api.typesafe.ai/v1
# Free OpenJev on Codiv: JEV_BASE_URL=https://api.codiv.ai/v1 JEV_MODEL=openjev-latest
