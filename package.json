{
  "name": "@merijjeyn/jive",
  "version": "0.1.0",
  "description": "A terminal coding agent that plans work as executable graphs: bash commands and bounded model decisions run locally as branches, loops, and parallel batches between planner turns.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/merijjeyn/jive.git"
  },
  "homepage": "https://github.com/merijjeyn/jive#readme",
  "bugs": "https://github.com/merijjeyn/jive/issues",
  "keywords": [
    "agent",
    "cli",
    "terminal",
    "llm",
    "openrouter",
    "anthropic",
    "openai",
    "bun",
    "tui",
    "graph"
  ],
  "type": "module",
  "bin": {
    "jive": "./bin/jive"
  },
  "files": [
    "bin/jive",
    "bin/jive.ts",
    "bin/install.sh",
    "src",
    "examples",
    "docs",
    "!docs/assets",
    "DESIGN.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "bun src/cli.tsx",
    "demo": "bun src/cli.tsx --demo",
    "test": "bun test",
    "eval:planner": "bun bin/eval-planner.ts",
    "taskground": "bun bin/taskground.ts",
    "typecheck": "tsc --noEmit",
    "jive": "./bin/jive",
    "install-cli": "./bin/install.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@opentui/core": "0.5.11",
    "@opentui/react": "0.5.11",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0",
    "ajv": "8.20.0",
    "bun": "1.4.2",
    "marked": "17.0.1",
    "react": "19.3.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
